---
import type { ImageType } from '@/types';

import { twMerge } from 'tailwind-merge';
import Image from '../Image';
interface BlurredBackdropProps {
  class?: string;
  image: ImageType;
  blur?: number;
  saturate?: number;
  height?: number;
  width?: number;
}
export type Props = BlurredBackdropProps;
const {
  class: className,
  image,
  blur = 180,
  saturate = 1.5,
  ...rest
} = Astro.props;

---
<div class={twMerge(
  'opacity-50 dark:opacity-70 overflow-hidden select-none',
  className,
)} style={{
  filter: `blur(${blur}px) saturate(${saturate})`,
  ...rest,
}}>
  <Image src={image} inferSize alt='' aria-hidden="true" class='object-fill h-full w-full' loading='eager' />
</div>
