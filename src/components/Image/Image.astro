---
import BlurHash from './BlurHash';
import { getImage } from 'astro:assets';
import { DEV, DIST_DIR, FS_PREFIX } from '@/constants';
import { imageToHashBase64 } from './converter';
import { twMerge } from 'tailwind-merge';
import type { RemoteImageProps as AstroRemoteImageProps, LocalImageProps as AstroLocalImageProps } from 'astro:assets';
import type { HTMLAttributes } from 'astro/types';
import type { UnresolvedImageTransform } from 'astro';
import { join } from '@/utils/url';

type ExtraProps = {
  src: string | ImageMetadata | Promise<{default: ImageMetadata}>;
  alt?: string;
  inferSize?: boolean;
  onlyBlur?: boolean;
  disableBlur?: boolean;
};
type LocalImageProps = Omit<AstroLocalImageProps, keyof ExtraProps> & ExtraProps;
type RemoteImageProps = Omit<AstroRemoteImageProps, keyof ExtraProps> & ExtraProps;
export type Props = LocalImageProps | RemoteImageProps;
const {
  src,
  class: className,
  onlyBlur = false,
  disableBlur = false,
  inferSize,
  ...rest
} = Astro.props;

function isESMImportedImage(src: any): src is ImageMetadata |  Promise<{default: ImageMetadata}> {
  return typeof src === "object";
}

const isRemoteImage = typeof src === 'string' && URL.canParse(src);
// Remote images are intentionally left unoptimized. Many legacy post images
// are hosted on third-party domains that may be unavailable during a build.
const image = isRemoteImage ? undefined : await getImage({
  src,
  inferSize,
  ...rest,
} as UnresolvedImageTransform);
const renderedSrc = image?.src ?? src as string;
const renderedAttributes = image?.attributes ?? rest;

const additionalAttributes: HTMLAttributes<'img'> = {};
if (image && image.srcSet.values.length > 0) {
  additionalAttributes.srcset = image.srcSet.attribute;
}

let blurhash: string | undefined = undefined;
if (image && image.options.format !== 'svg' && isESMImportedImage(src) && !disableBlur) {
  const resolvedSrc = 'then' in src ? (await src).default : src;
  const filePath = DEV
		? new RegExp(`^${FS_PREFIX}([^?#]*)`).exec(resolvedSrc.src)?.[1] ?? ''
		: join('.' , DIST_DIR, resolvedSrc.src);
  blurhash = await imageToHashBase64(filePath);
}
---
{onlyBlur ? (
  blurhash ? (
    <BlurHash
      className={className ?? undefined}
      src={renderedSrc}
      blurhash={blurhash}
      fadeOut={false}
      client:load
    />
  ) : (
    <div class={className}>
      <img src={renderedSrc} class='h-full w-full object-cover blur-xl scale-125' {...additionalAttributes} {...renderedAttributes} />
    </div>
  )
) : (
  <div class={twMerge(
    "relative inline-block overflow-hidden",
    className
  )}>
    {<img src={renderedSrc} class="w-full h-full object-cover" {...additionalAttributes} {...renderedAttributes} />}
    {blurhash && (
      <BlurHash
        className="absolute inset-0"
        src={renderedSrc}
        blurhash={blurhash}
        client:load
      />
    )}
  </div>
)}

